{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall-patch-aurora.js",
    "build": "hexo generate && node scripts/patch-categories-chunk.js",
    "build:local": "NODE_OPTIONS='--max-old-space-size=2048' hexo generate --incremental",
    "build:full": "NODE_OPTIONS='--max-old-space-size=2048' hexo generate && node scripts/patch-categories-chunk.js",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-filter-nofollow": "^2.0.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-baidu-sitemap": "^0.1.9",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-robotstxt": "^0.2.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-plugin-aurora": "^1.8.4",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-aurora": "^2.5.3",
    "hexo-wordcount": "^6.0.1",
    "hexo-yam": "^9.0.0"
  }
}
